# SA-S4: the image builds with pnpm (frontend/pnpm-lock.yaml is the real,
# tracked lockfile) — an npm-format package-lock.json here would describe
# a different install than what actually ships and is easy to mistake for
# the one that matters.
frontend/package-lock.json
