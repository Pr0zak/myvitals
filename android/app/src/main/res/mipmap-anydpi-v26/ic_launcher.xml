<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Its OWN drawable, not the colour foreground reused. The themed-icon
         slot is tinted flat by the system, so pointing it at the colour path
         set meant every hue collapsed to one and the mark lost the only thing
         distinguishing it. -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
