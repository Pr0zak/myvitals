# --- database ---
POSTGRES_USER=myvitals
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myvitals
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- image source (GHCR) ---
# Lowercase GitHub owner. Override only if you fork.
GHCR_OWNER=pr0zak
# Image tag to run. "latest" tracks the newest release; pin to "0.1.0" etc. for stability.
BACKEND_TAG=latest
FRONTEND_TAG=latest

# --- backend ---
# bearer token the Android app must present on POST /ingest/*
INGEST_TOKEN=replace-with-long-random-string
# bearer token for read endpoints used by the frontend
QUERY_TOKEN=replace-with-another-long-random-string
# Optional read-only tokens for other self-hosted apps (a dashboard, a
# timeline aggregator). Comma-separated name:token pairs, each token at
# least 24 characters (`openssl rand -hex 32`), e.g.
#   SCOPED_READ_TOKENS=aggregator:<token>,dashboard:<another-token>
# They can only GET an allow-listed set of routes (summaries, sleep, HRV,
# activities without routes, strength, trails, alerts) and never see
# sobriety, fasting, blood pressure, the journal or route geometry.
# See backend/src/myvitals/auth.py for the exact list.
SCOPED_READ_TOKENS=
LOG_LEVEL=INFO
# IANA timezone — used for daily summary cutoffs (e.g. "America/New_York", "Europe/London")
TZ=UTC

# --- home assistant integration (optional) ---
# Local HA URL on your network (default mDNS hostname is homeassistant.local:8123)
HA_URL=
HA_TOKEN=
# Comma-separated entity IDs to poll every 5 min into env_readings.
# Examples:
#   sensor.bedroom_temperature,sensor.bedroom_humidity,binary_sensor.bedroom_presence
HA_ENTITIES=

# --- weather integration (optional) ---
OPENWEATHER_API_KEY=
HOME_LAT=
HOME_LON=

# --- Strava OAuth (optional) ---
# Create an app at https://www.strava.com/settings/api
# Authorization Callback Domain must match the host of STRAVA_CALLBACK_URL.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_CALLBACK_URL=http://your-server:8000/auth/strava/callback
